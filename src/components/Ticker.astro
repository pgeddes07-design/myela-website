---
import { FLAVOURS } from '../data/site';
const names = FLAVOURS.map((f) => f.name);
const star = 'M24 4 C 25.5 16, 32 22.5, 44 24 C 32 25.5, 25.5 32, 24 44 C 22.5 32, 16 25.5, 4 24 C 16 22.5, 22.5 16, 24 4 Z';
---
<div class="me-ticker" role="presentation">
  <p class="me-sr">Flavours: {names.join(', ')}.</p>
  <div class="me-ticker__track" aria-hidden="true">
    {[0, 1].map(() => (
      <span class="me-ticker__set">
        {names.map((n) => (
          <span class="me-ticker__item">
            {n}
            <svg viewBox="0 0 48 48" width="22" height="22"><path d={star} /></svg>
          </span>
        ))}
      </span>
    ))}
  </div>
</div>
