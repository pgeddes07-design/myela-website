---
import Doodle from './Doodle.astro';
import Icon from './Icon.astro';
const audiences = ['Tuckshops', 'School events', 'Coffee trucks'];
const offer = ['Eight flavours to rotate', 'Sealed, frozen and ready for the freezer', '120g tuckshop size, 200g for events', 'Bulk pricing for regular orders'];
---
<section class="me-stockist" id="stock-myela" aria-labelledby="stockist-title">
  <Doodle shape="sparkle" tone="mint" size={44} class="me-stockist__spark me-stockist__spark--a" />
  <Doodle shape="burst" tone="light" size={56} class="me-stockist__spark me-stockist__spark--b" />
  <div class="me-stockist__copy">
    <h2 class="me-h2" id="stockist-title">Myela for your school</h2>
    <p class="me-stockist__body">Run a school tuckshop, a school event or a coffee truck? This is what we do best. Message us on WhatsApp with what you need and we'll send you bulk pricing.</p>
    <ul class="me-stockist__aud" aria-label="Who we supply">{audiences.map((a) => <li>{a}</li>)}</ul>
  </div>
  <div class="me-stockist__action">
    <ul class="me-stockist__offer">
      {offer.map((o) => <li><Icon name="check" /><span>{o}</span></li>)}
    </ul>
  </div>
</section>
