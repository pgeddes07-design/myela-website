---
import { HOW_TO_ORDER } from '../data/site';
---
<div class="me-steps" data-draw>
  <svg class="me-steps__line" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path pathLength="1" d="M10 34 C 150 -6, 300 70, 500 30 S 850 -6, 990 34" />
  </svg>
  <ol class="me-steps__list">
    {HOW_TO_ORDER.map((s, i) => (
      <li class="me-step" data-reveal="pop" style={`--delay:${200 + i * 260}ms`}>
        <span class={`me-step__num me-step__num--${i + 1}`} aria-hidden="true">{i + 1}</span>
        <div>
          <h3 class="me-step__title">{s.title}</h3>
          <p class="me-step__body">{s.body}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
