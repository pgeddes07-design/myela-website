---
// Original hand-drawn marks. Always decorative.
type Shape = 'arrow' | 'arrowDown' | 'sparkle' | 'burst' | 'swoosh' | 'loop';
interface Props {
  shape?: Shape;
  tone?: 'white' | 'plum' | 'pink' | 'mint' | 'light';
  size?: number;
  rotate?: number;
  label?: string;
  labelPosition?: 'start' | 'end' | 'above' | 'below';
  draw?: boolean; // draw itself in when scrolled into view
  delay?: number;
  class?: string;
}
const DOODLES: Record<Shape, { vb: string; d: string[] }> = {
  arrow: { vb: '0 0 96 56', d: ['M6 46 C 22 16, 52 6, 84 16', 'M70 6 L 86 16 L 73 28'] },
  arrowDown: { vb: '0 0 56 96', d: ['M14 6 C 40 22, 46 50, 32 84', 'M20 72 L 32 86 L 45 73'] },
  sparkle: { vb: '0 0 48 48', d: ['M24 4 C 25.5 16, 32 22.5, 44 24 C 32 25.5, 25.5 32, 24 44 C 22.5 32, 16 25.5, 4 24 C 16 22.5, 22.5 16, 24 4 Z'] },
  burst: { vb: '0 0 64 64', d: ['M32 6 V 18', 'M32 46 V 58', 'M6 32 H 18', 'M46 32 H 58', 'M14 14 L 22 22', 'M42 42 L 50 50', 'M50 14 L 42 22', 'M22 42 L 14 50'] },
  swoosh: { vb: '0 0 160 20', d: ['M4 13 C 40 6, 92 4, 156 9', 'M22 17 C 62 12, 104 12, 140 15'] },
  loop: { vb: '0 0 96 48', d: ['M4 40 C 22 40, 32 30, 36 18 C 40 6, 58 6, 56 20 C 54 32, 36 30, 42 18 C 48 8, 70 10, 92 6'] },
};
const { shape = 'sparkle', tone = 'white', size = 48, rotate, label, labelPosition = 'end', draw = false, delay = 0, class: cls } = Astro.props;
const s = DOODLES[shape];
const [, , vw, vh] = s.vb.split(' ').map(Number);
const h = Math.round((size * vh) / vw);
const before = labelPosition === 'start' || labelPosition === 'above';
const classes = ['me-doodle', `me-doodle--${tone}`, label && `me-doodle--${labelPosition}`, cls].filter(Boolean).join(' ');
---
<span class={classes} aria-hidden="true">
  {label && before && <span class="me-doodle__label">{label}</span>}
  <svg class="me-doodle__mark" viewBox={s.vb} width={size} height={h} focusable="false" data-draw={draw ? '' : undefined} style={`${rotate ? `transform: rotate(${rotate}deg);` : ''}--d:${delay}s`}>
    {s.d.map((d) => draw
      ? <path d={d} pathLength="1" fill="none" stroke="currentColor" stroke-width={Math.max(2, (3 * vw) / size).toFixed(2)} stroke-linecap="round" stroke-linejoin="round" />
      : <path d={d} fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />)}
  </svg>
  {label && !before && <span class="me-doodle__label">{label}</span>}
</span>
