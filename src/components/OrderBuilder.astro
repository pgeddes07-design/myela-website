---
// Version B: the pour machine doubles as an order builder.
// Tap a flavour to watch it pour, add it to your order, then send the whole
// order to WhatsApp with the message already written.
import Doodle from './Doodle.astro';
import Icon from './Icon.astro';
import { FLAVOURS, MESSAGES, whatsappLink } from '../data/site';
const first = FLAVOURS[0];
const fallback = whatsappLink(MESSAGES.customer) ?? '#';
const uses = ['School tuckshop', 'School event', 'Coffee truck', 'Just me'];
---
<div class="me-pour me-builder" style={`--pour-colour:${first.colour}`}>
  <div class="me-pour__stage">
    <svg class="me-pour__svg" viewBox="0 0 360 430" role="img" aria-label="Animation of frozen yoghurt being swirled into a Myela cup">
      <g class="me-pour__nozzle" fill="rgba(255,255,255,0.35)" stroke="#fff" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
        <path d="M128 -4 H232 V26 Q232 40 218 42 H142 Q128 40 128 26 Z" />
        <path d="M160 42 L200 42 L190 68 L170 68 Z" />
        <path d="M176 47 L177 64 M184 47 L183 64" fill="none" />
        <path d="M144 14 H216" fill="none" opacity="0.7" />
      </g>
    </svg>
    <Doodle shape="sparkle" tone="white" size={30} class="me-pour__spark me-pour__spark--a" />
    <Doodle shape="sparkle" tone="white" size={20} class="me-pour__spark me-pour__spark--b" />
  </div>

  <div class="me-pour__panel">
    <p class="me-pour__hint" aria-hidden="true">1. tap a flavour</p>
    <div class="me-pour__menu" role="group" aria-label="Choose a flavour">
      {FLAVOURS.map((f, i) => (
        <button type="button" class="me-pour__btn" data-flavour={f.name} data-colour={f.colour} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="me-pour__dot" style={`background:${f.colour}`} aria-hidden="true"></span>
          {f.name}
        </button>
      ))}
    </div>
    <p class="me-pour__now"><span class="me-sr">Now pouring: </span><span class="me-pour__name" aria-live="polite">{first.name}</span></p>

    <p class="me-pour__hint" aria-hidden="true">2. add it to your order</p>
    <div class="me-builder__add">
      <div class="me-builder__sizes" role="radiogroup" aria-label="Cup size">
        <label><input type="radio" name="me-size" value="120g" checked /><span>120g</span></label>
        <label><input type="radio" name="me-size" value="200g" /><span>200g</span></label>
      </div>
      <button type="button" class="me-builder__addbtn" data-add>
        <span aria-hidden="true">+</span> Add <span data-add-name>{first.name}</span>
      </button>
    </div>
  </div>

  <div class="me-builder__order">
    <h3 class="me-builder__title">Your order</h3>
    <p class="me-builder__empty" data-empty>Nothing in here yet. Tap a flavour and add it.</p>
    <ul class="me-builder__lines" data-lines aria-live="polite"></ul>
    <p class="me-builder__total" data-total hidden></p>

    <fieldset class="me-builder__for">
      <legend>It's for</legend>
      {uses.map((u) => <label><input type="radio" name="me-for" value={u} /><span>{u}</span></label>)}
    </fieldset>

    <a class="me-btn me-btn--primary me-btn--lg me-btn--block me-builder__send" href={fallback} target="_blank" rel="noopener noreferrer" data-wa="order" data-send>
      <Icon name="chat" /><span class="me-btn__label">Send my order on WhatsApp</span>
    </a>
    <p class="me-builder__note">Opens WhatsApp with your order typed out. We'll reply with pricing and when you can have it.</p>
  </div>
</div>

<script>
  import '../scripts/pour.ts';
  import '../scripts/order.ts';
</script>
