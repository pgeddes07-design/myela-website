---
// Hand-drawn fruit line art. Draws itself in when it scrolls into view.
type Fruit = 'strawberry' | 'cherries' | 'mango' | 'litchi' | 'raspberry' | 'passion' | 'drop' | 'leaf' | 'cup120';
interface Props {
  fruit: Fruit;
  tone?: 'white' | 'plum' | 'pink' | 'mint' | 'berry' | 'purple';
  size?: number;
  rotate?: number;
  delay?: number; // seconds before it draws
  class?: string;
}
const { fruit, tone = 'white', size = 72, rotate = 0, delay = 0, class: cls } = Astro.props;

function bumpy(cx: number, cy: number, r: number, n: number, b: number) {
  let d = '';
  for (let i = 0; i <= n; i++) {
    const a = (i / n) * Math.PI * 2;
    const x = cx + r * Math.cos(a), y = cy + r * Math.sin(a);
    if (i === 0) { d += `M${x.toFixed(1)} ${y.toFixed(1)}`; continue; }
    const am = ((i - 0.5) / n) * Math.PI * 2;
    d += ` Q${(cx + (r + b) * Math.cos(am)).toFixed(1)} ${(cy + (r + b) * Math.sin(am)).toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return d + ' Z';
}
const circle = (cx: number, cy: number, r: number) => `M${cx - r} ${cy} A${r} ${r} 0 1 0 ${cx + r} ${cy} A${r} ${r} 0 1 0 ${cx - r} ${cy} Z`;

const PATHS: Record<Fruit, string[]> = {
  strawberry: [
    'M32 58 C 20 52, 10 40, 12 28 C 13 20, 22 17, 32 21 C 42 17, 51 20, 52 28 C 54 40, 44 52, 32 58 Z',
    'M20 22 C 22 15, 28 14, 32 19 C 36 14, 43 15, 44 22', 'M26 18 C 28 12, 36 12, 38 18', 'M32 19 C 32 14, 33 10, 35 7',
    'M24 30 l1.5 2.5', 'M38 29 l1.5 2.5', 'M31 36 l1.5 2.5', 'M43 37 l1.5 2.5', 'M21 40 l1.5 2.5', 'M27 47 l1.5 2.5', 'M37 46 l1.5 2.5',
  ],
  cherries: [
    circle(18, 46, 10), circle(42, 50, 10),
    'M18 36 C 22 24, 30 14, 40 9', 'M42 40 C 41 28, 38 18, 40 9', 'M40 9 C 47 4, 55 6, 58 12 C 51 15, 45 14, 40 9 Z', 'M13 44 C 13 41, 15 39, 17 39',
  ],
  mango: [
    'M12 40 C 8 24, 22 10, 38 12 C 54 14, 58 32, 50 44 C 42 56, 18 56, 12 40 Z',
    'M38 12 C 40 6, 46 3, 54 5 C 52 11, 46 14, 38 12 Z', 'M38 12 L 36 7', 'M20 36 C 20 28, 26 22, 33 21',
  ],
  litchi: [
    bumpy(32, 36, 19, 16, 3.2),
    'M32 16 C 32 12, 34 8, 37 6', 'M37 6 C 43 3, 50 5, 52 10 C 46 12, 41 10, 37 6 Z', 'M24 32 l3 3 l3 -3', 'M33 42 l3 3 l3 -3', 'M36 28 l3 3 l3 -3',
  ],
  raspberry: [
    circle(24, 24, 4.5), circle(32, 24, 4.5), circle(40, 24, 4.5),
    circle(20, 32, 4.5), circle(28, 32, 4.5), circle(36, 32, 4.5), circle(44, 32, 4.5),
    circle(24, 40, 4.5), circle(32, 40, 4.5), circle(40, 40, 4.5),
    circle(28, 48, 4.5), circle(36, 48, 4.5), circle(32, 55, 4.5),
    'M22 18 C 26 12, 30 14, 32 17 C 34 14, 38 12, 42 18', 'M32 17 V 9',
  ],
  passion: [
    circle(32, 34, 22), circle(32, 34, 15),
    circle(27, 29, 1.8), circle(36, 28, 1.8), circle(25, 38, 1.8), circle(33, 36, 1.8), circle(40, 38, 1.8), circle(30, 43, 1.8), circle(38, 31, 1.8),
  ],
  drop: ['M32 6 C 38 20, 47 29, 47 40 A 15 15 0 0 1 17 40 C 17 29, 26 20, 32 6 Z', 'M24 42 C 24 37, 26 34, 29 32'],
  cup120: [
    'M10 24 A 22 5 0 1 0 54 24 A 22 5 0 1 0 10 24 Z', 'M26 23.5 A 6 2 0 1 0 38 23.5 A 6 2 0 1 0 26 23.5 Z',
    'M12 26 L 17 56 Q 32 60 47 56 L 52 26', 'M15 36 C 24 32, 40 32, 49 36', 'M16 44 C 25 40, 39 40, 48 44', 'M17 51 C 26 48, 38 48, 47 51',
  ],
  leaf: ['M10 54 C 14 30, 34 12, 56 10 C 54 32, 36 52, 10 54 Z', 'M10 54 C 24 40, 38 26, 56 10', 'M26 40 L 24 30', 'M36 30 L 34 20', 'M30 44 L 40 42'],
};
const classes = ['me-sketch', `me-sketch--${tone}`, cls].filter(Boolean).join(' ');
---
<svg
  class={classes}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  data-draw
  style={`--d:${delay}s;${rotate ? `rotate:${rotate}deg;` : ''}`}
>
  {PATHS[fruit].map((d) => <path d={d} pathLength="1" />)}
</svg>
