---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-plum.png';
import FruitSketch from './FruitSketch.astro';
import Fly from './Fly.astro';
import Doodle from './Doodle.astro';
import sketch from '../assets/story/miya-ella-sketch.webp';
import { CUTOUTS, STORY } from '../data/site';
---
<section class="me-section me-story" id="story" aria-labelledby="story-title">
  <Fly x={-220} y={0} r={-25} class="me-story__fly me-story__fly--a">
    <Image src={CUTOUTS.cherry} alt="" widths={[200, 300]} sizes="150px" loading="lazy" />
  </Fly>
  <Fly x={0} y={-160} r={20} class="me-story__fly me-story__fly--b"><FruitSketch fruit="raspberry" tone="pink" size={84} /></Fly>
  <Fly x={120} y={-80} r={-20} class="me-story__fly me-story__fly--c"><FruitSketch fruit="litchi" tone="purple" size={76} /></Fly>

  <div class="me-container me-story__grid">
    <div class="me-story__art" data-reveal="pop">
      <figure class="me-story__frame">
        <Image class="me-story__sketch" src={sketch} alt="Pencil sketch of Miya and Ella: one pulling the lever to swirl frozen yoghurt into a cup, the other tucking into hers with a spoon." widths={[480, 720, 960, 1280]} sizes="(max-width: 760px) 92vw, 620px" loading="lazy" />
        {STORY.note && <figcaption class="me-story__note">{STORY.note}</figcaption>}
        <span class="me-story__badge"><Image src={logo} alt="" width={120} height={120} densities={[1, 2]} loading="lazy" /></span>
      </figure>
      <Doodle shape="sparkle" tone="pink" size={40} class="me-story__spark me-story__spark--a me-twinkle" />
      <Doodle shape="sparkle" tone="pink" size={28} class="me-story__spark me-story__spark--b me-twinkle" />
    </div>

    <div class="me-story__copy" data-reveal>
      <p class="me-eyebrow">Our story</p>
      <h2 class="me-h2" id="story-title">{STORY.heading}</h2>
      <Doodle shape="swoosh" tone="pink" size={220} class="me-story__swoosh" draw />
      {STORY.paragraphs.map((p) => <p class="me-story__p">{p}</p>)}
    </div>
  </div>
</section>
