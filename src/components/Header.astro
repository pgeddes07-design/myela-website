---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-plum.png';
import WhatsAppButton from './WhatsAppButton.astro';

const home = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const links = [
  { label: 'Our Story', href: `${home}#story` },
  { label: 'Schools', href: `${home}#stock-myela` },
  { label: 'Flavours', href: `${home}#flavours` },
  { label: 'Sizes', href: `${home}#sizes` },
  { label: 'Where to Find', href: `${home}#find-us` },
];
---
<header class="me-header">
  <div class="me-header__inner">
    <a class="me-header__home" href={`${home}#top`} aria-label="Myela home">
      <span class="me-header__badge">
        <Image class="me-logo" src={logo} alt="Myela frozen yoghurt" height={84} width={84} densities={[1, 2, 3]} loading="eager" />
      </span>
    </a>
    <nav class="me-header__nav" aria-label="Main">
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <div class="me-header__cta">
      <WhatsAppButton size="sm" shortLabel="WhatsApp" class="me-header__order" />
    </div>
    <details class="me-header__menu">
      <summary aria-label="Menu"><span class="me-burger" aria-hidden="true"><span></span><span></span><span></span></span></summary>
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </details>
  </div>
</header>

<script>
  // Header badge rolls in once the big hero logo has scrolled away.
  const header = document.querySelector<HTMLElement>('.me-header');
  const heroLogo = document.querySelector('.hx__title');
  if (header && heroLogo && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => header.classList.toggle('has-logo', !e.isIntersecting), { rootMargin: '-88px 0px 0px 0px' }).observe(heroLogo);
  } else {
    header?.classList.add('has-logo');
  }

  // Close the phone menu after a link is tapped.
  const menu = document.querySelector<HTMLDetailsElement>('.me-header__menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
</script>
