---
import '@fontsource/fredoka/latin-600.css';
import '@fontsource/fredoka/latin-700.css';
import '@fontsource/nunito-sans/latin-400.css';
import '@fontsource/nunito-sans/latin-600.css';
import '@fontsource/nunito-sans/latin-700.css';
import '@fontsource/nunito-sans/latin-800.css';
import '@fontsource/caveat/latin-600.css';
import '../styles/global.css';
import '../styles/motion.css';
import { SITE, WHATSAPP_NUMBER } from '../data/site';

interface Props {
  /** Extra class on <body>, e.g. "v-b" for the version B test page. */
  bodyClass?: string;
  /** Keep helper pages (like the old /b/ link) out of Google. */
  noindex?: boolean;
  title?: string;
}
const { bodyClass, noindex = false, title = SITE.title } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Test pages point Google at the real homepage.
const canonical = noindex ? new URL(`${base}/`, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og-image.jpg`, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Myela Frozen Yoghurt',
  url: canonical.href,
  logo: new URL(`${base}/icon-512.png`, Astro.site).href,
  description: SITE.description,
  address: { '@type': 'PostalAddress', addressLocality: SITE.base, addressRegion: 'Gauteng', addressCountry: 'ZA' },
  areaServed: [SITE.base, ...SITE.areas.map((a) => a.replace(/^the /, '')), SITE.city].map((name) => ({ '@type': 'Place', name })),
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${WHATSAPP_NUMBER}`,
    contactType: 'sales',
    areaServed: 'ZA',
    availableLanguage: 'English',
  },
};
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={SITE.description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ada2e5" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Myela" />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={bodyClass}>
    <a class="me-skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
