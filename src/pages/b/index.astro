---
// Version B is now the homepage. Old /b/ links land there.
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${home}`} />
    <link rel="canonical" href={home} />
    <title>Myela Frozen Yoghurt</title>
  </head>
  <body><a href={home}>Go to the Myela homepage</a></body>
</html>
