---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/version-b.css';
import Header from '../components/Header.astro';
import HeroB from '../components/HeroB.astro';
import Ticker from '../components/Ticker.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FlavourCard from '../components/FlavourCard.astro';
import SizeCard from '../components/SizeCard.astro';
import Story from '../components/Story.astro';
import OutletCard from '../components/OutletCard.astro';
import StockistPanel from '../components/StockistPanel.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Doodle from '../components/Doodle.astro';
import OrderBuilder from '../components/OrderBuilder.astro';
import { CUTOUTS, FLAVOURS, OUTLETS, SIZES } from '../data/site';
import garden from '../assets/lifestyle/strawberry-garden.webp';
import kidsSketch from '../assets/lifestyle/kids-sketch.webp';
---
<Base bodyClass="v-b">
  <Header />
  <main id="main">
    <HeroB />
    <Ticker />
    <Story calm />
    <section class="me-section me-deco" aria-label="Stock Myela">
      <span class="me-fly me-deco__item me-deco--st-a me-deco__cup" aria-hidden="true"><span class="me-fly__inner">
        <Image src={CUTOUTS.fruitsOfTheForest} alt="" widths={[200, 300]} sizes="150px" loading="lazy" />
      </span></span>
      <div class="me-container" data-reveal="pop">
        <StockistPanel />
      </div>
    </section>

    <section class="me-section me-section--flavours me-deco" id="flavours" aria-labelledby="flavours-title">
      <div class="me-container">
        <div data-reveal>
          <SectionHeader id="flavours-title" title="Build your order" intro="Tap a flavour to watch it pour, add it to your order, and send it straight to us on WhatsApp." />
        </div>
        <div data-reveal="pop"><OrderBuilder /></div>
        <p class="me-flavour-intro" data-reveal>And here's the real thing, sealed in our 200g cups:</p>
        <ul class="me-flavour-grid">
          {FLAVOURS.map((f, i) => <li data-reveal style={`--delay:${(i % 4) * 80}ms`}><FlavourCard flavour={f} /></li>)}
        </ul>
      </div>
    </section>

    <section class="me-section me-section--sizes me-deco" id="sizes" aria-labelledby="sizes-title">
      <div class="me-container">
        <div data-reveal>
          <SectionHeader id="sizes-title" title="Two sizes. Lots of happy." intro="A little treat or a little more? Pick the cup that suits you." />
        </div>
        <div class="me-grid-2">
          {SIZES.map((s, i) => <div data-reveal={i === 0 ? 'left' : 'right'}><SizeCard size={s} /></div>)}
        </div>
        <p class="me-footnote" data-reveal>Buying for a school or tuckshop? Message us on WhatsApp for bulk pricing.</p>
      </div>
    </section>

    <section class="me-section me-section--blush me-deco" id="find-us" aria-labelledby="find-title">
      <div class="me-container">
        <div class="me-find__top">
          <div class="me-find__head" data-reveal>
            <h2 class="me-h2" id="find-title">Where to find Myela</h2>
            <p class="me-find__intro">We don't have our own shop. Most of our cups go to schools across Randburg, Fourways, Sandton and the West Rand, and small orders are collected in Randpark Ridge.</p>
          </div>
          <figure class="me-chalk" data-reveal="chalk">
            <Image src={kidsSketch} alt="Chalk drawing of two kids laughing over their frozen yoghurt" widths={[480, 720, 960, 1332]} sizes="(max-width: 900px) 92vw, 620px" loading="lazy" />
            <Doodle shape="sparkle" tone="pink" size={34} class="me-chalk__spark me-chalk__spark--a me-twinkle" />
            <Doodle shape="swoosh" tone="pink" size={200} class="me-chalk__swoosh" draw delay={1.4} />
          </figure>
        </div>
        <div class="me-grid-3">
          {OUTLETS.map((o, i) => <div data-reveal style={`--delay:${i * 100}ms`}><OutletCard {...o} /></div>)}
        </div>
        
      </div>
    </section>


    <section class="me-section me-section--blush me-deco" id="order" aria-labelledby="order-title">
      <div class="me-container">
        <div data-reveal>
          <SectionHeader id="order-title" title="Good to know" intro="Anything else? Message us on WhatsApp and Kate will get back to you." />
        </div>
        <div class="me-know">
          <figure class="me-know__photo" data-reveal="left">
            <Image src={garden} alt="Someone enjoying a strawberry frozen yoghurt in the garden" widths={[400, 600, 800, 1024]} sizes="(max-width: 760px) 92vw, 420px" loading="lazy" />
          </figure>
          <div class="me-know__faq" data-reveal="right"><Faq /></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
