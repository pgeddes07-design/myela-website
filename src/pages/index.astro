---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FlavourCard from '../components/FlavourCard.astro';
import SizeCard from '../components/SizeCard.astro';
import Story from '../components/Story.astro';
import OutletCard from '../components/OutletCard.astro';
import StockistPanel from '../components/StockistPanel.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import FruitSketch from '../components/FruitSketch.astro';
import Fly from '../components/Fly.astro';
import PourStage from '../components/PourStage.astro';
import { CUTOUTS, FLAVOURS, OUTLETS, SIZES } from '../data/site';
import garden from '../assets/lifestyle/strawberry-garden.webp';
---
<Base>
  <Header />
  <main id="main">
    <Hero />
    <Ticker />
    <Story />
    <section class="me-section me-deco" aria-label="Stock Myela">
      <Fly x={320} y={-80} r={30} class="me-deco__item me-deco--st-a me-deco__cup">
        <Image src={CUTOUTS.fruitsOfTheForest} alt="" widths={[200, 300]} sizes="150px" loading="lazy" />
      </Fly>
      <div class="me-container" data-reveal="pop">
        <StockistPanel />
      </div>
    </section>

    <section class="me-section me-section--flavours me-deco" id="flavours" aria-labelledby="flavours-title">
      <Fly x={-260} y={40} r={-30} class="me-deco__item me-deco--fl-a"><FruitSketch fruit="strawberry" tone="pink" size={86} /></Fly>
      <Fly x={220} y={-60} r={30} class="me-deco__item me-deco--fl-b"><FruitSketch fruit="cherries" tone="berry" size={90} /></Fly>
      <div class="me-container">
        <div data-reveal>
          <SectionHeader id="flavours-title" title="Find your flavour!" intro="Which one will you choose? Explore the Myela range below." sparkle />
        </div>
        <div data-reveal="pop"><PourStage /></div>
        <p class="me-flavour-intro" data-reveal>And here's the real thing, sealed in our 200g cups:</p>
        <ul class="me-flavour-grid">
          {FLAVOURS.map((f, i) => <li data-reveal style={`--delay:${(i % 4) * 80}ms`}><FlavourCard flavour={f} /></li>)}
        </ul>
      </div>
    </section>

    <section class="me-section me-section--sizes me-deco" id="sizes" aria-labelledby="sizes-title">
      <Fly x={200} y={80} r={24} class="me-deco__item me-deco--sz-b"><FruitSketch fruit="mango" tone="purple" size={84} /></Fly>
      <Fly x={-120} y={-120} r={-40} class="me-deco__item me-deco--sz-c"><FruitSketch fruit="drop" tone="pink" size={56} /></Fly>
      <div class="me-container">
        <div data-reveal>
          <SectionHeader id="sizes-title" title="Two sizes. Lots of happy." intro="A little treat or a little more? Pick the cup that suits you." />
        </div>
        <div class="me-grid-2">
          {SIZES.map((s, i) => <div data-reveal={i === 0 ? 'left' : 'right'}><SizeCard size={s} /></div>)}
        </div>
        <p class="me-footnote" data-reveal>Buying for a school or tuckshop? Message us on WhatsApp for bulk pricing.</p>
      </div>
    </section>

    <section class="me-section me-section--blush me-deco" id="find-us" aria-labelledby="find-title">
      <Fly x={240} y={-40} r={30} class="me-deco__item me-deco--fi-a"><FruitSketch fruit="passion" tone="berry" size={80} /></Fly>
      <Fly x={-200} y={60} r={-24} class="me-deco__item me-deco--fi-b"><FruitSketch fruit="leaf" tone="purple" size={76} /></Fly>
      <div class="me-container">
        <div data-reveal>
          <SectionHeader id="find-title" title="Where to find Myela" intro="We don't have our own shop. Most of our cups go to schools across Randburg, Fourways, Sandton and the West Rand, and small orders are collected in Randpark Ridge." />
        </div>
        <div class="me-grid-3">
          {OUTLETS.map((o, i) => <div data-reveal style={`--delay:${i * 100}ms`}><OutletCard {...o} /></div>)}
        </div>
        
      </div>
    </section>


    <section class="me-section me-section--blush me-deco" id="order" aria-labelledby="order-title">
      <Fly x={180} y={60} r={30} class="me-deco__item me-deco--or-b"><FruitSketch fruit="cherries" tone="pink" size={80} /></Fly>
      <div class="me-container">
        <div data-reveal>
          <SectionHeader id="order-title" title="Good to know" intro="Anything else? The WhatsApp button at the top goes straight to us." />
        </div>
        <div class="me-know">
          <figure class="me-know__photo" data-reveal="left">
            <Image src={garden} alt="Someone enjoying a strawberry frozen yoghurt in the garden" widths={[400, 600, 800, 1024]} sizes="(max-width: 760px) 92vw, 420px" loading="lazy" />
          </figure>
          <div class="me-know__faq" data-reveal="right"><Faq /></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
